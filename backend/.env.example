# ECDAT backend — example configuration (placeholders only, NEVER real secrets)
# Copy to `.env` (git-ignored) or export these variables in your environment.
# The frontend must NEVER contain any of these values.

# ── ECDAT settings ──────────────────────────────────────────────────────
# ECDAT_API_KEY=optional-bearer-token-for-all-non-health-endpoints
# ECDAT_GIT_TOKEN=server-side token for public-URL clones (github.com only)
# ECDAT_GIT_HOST=github.com
