# ECDAT backend — example configuration (placeholders only, NEVER real secrets)
# Copy to `.env` (git-ignored) or export these variables in your environment.
# The frontend must NEVER contain any of these values.

# ── Prototype NTRO sessions (HMAC-signed, 8h) ───────────────────────────────
# Required in production; dev falls back to an insecure built-in default.


# ── Demo NTRO passwords (prototype only, fictional accounts) ────────────────
# Defaults work out of the box; set these to override the documented demo
# passwords without touching code.
# NTRO_DEMO_PASSWORD_001=demo-ntro-001
# NTRO_DEMO_PASSWORD_002=demo-ntro-002

# ── GitHub authorization (REAL GitHub App or OAuth App) ─────────────────────
# Minimum repository permissions: contents=read, metadata=read.
# GITHUB_CLIENT_ID=your-github-app-client-id
# GITHUB_CLIENT_SECRET=your-github-app-client-secret
# GITHUB_APP_ID=your-github-app-id (optional, informational for now)
# Where the backend redirects after github.com authorization:
# GITHUB_FRONTEND_URL=http://localhost:5173

# ── Existing ECDAT settings (unchanged) ─────────────────────────────────────
# ECDAT_API_KEY=optional-bearer-token-for-all-non-health-endpoints
# ECDAT_GIT_TOKEN=server-side token for public-URL clones (github.com only)
# ECDAT_GIT_HOST=github.com

